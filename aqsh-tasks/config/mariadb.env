# Deploy-time configuration for MariaDB tasks.
# Mounted into aqsh at /etc/aqsh/config/mariadb.env via ConfigMap.
# Scripts source this file for environment-specific settings.

MINIO_ENDPOINT=http://minio.minio.svc.cluster.local:9000

# CRD apiGroup of the mariadb-operator generation on this cluster. Normally
# auto-detected through Kubernetes API discovery (the group serving the
# `mariadbs` resource), so this stays commented. Set it explicitly only for an
# unusual fork whose group cannot be confidently detected. Default when
# unset/undetectable: k8s.mariadb.com.
# MARIADB_OPERATOR_GROUP_DEFAULT=k8s.mariadb.com

# --- Cross-cluster replication (replication/attach, /status, /detach) --------
# NOTE: this file is a reference template. It is NOT baked into the image (the
# Dockerfile copies lib/, scripts/, and task*.yaml only) — the deployment
# supplies the real file through the aqsh ConfigMap. The two peer settings below
# are additionally per-cluster by nature: each AQSH's peer is the OTHER cluster,
# so they can only be set where per-cluster values live (in this repo's tests,
# each aqsh release's `aqsh.config.mariadb.env` in tests/mariadb/helmfile.yaml).
# The peer primary is reached through the mesh ExternalName Service that infra
# publishes in every namespace of every cluster: <namespace><suffix>, aliasing
# the primary's Service. An ExternalName carries no port of its own, so the port
# below is the one on the Service it aliases.
# REPL_PEER_SERVICE_SUFFIX_DEFAULT=-rw
# REPL_PEER_PORT_DEFAULT=3306

# Connection guard for attach. An attach may conclude the standby has to be
# rebuilt, which destroys its data, so it refuses to run while anything is still
# connected. 0 means any external connection blocks it.
# REPL_MAX_EXTERNAL_CONNECTIONS_DEFAULT=0

# Accounts that never count as external connections: platform-owned sessions
# (operator probes, monitoring, healthchecks). MariaDB's own internal threads and
# the replication threads are always excluded regardless of this list.
# REPL_IGNORED_ACCOUNTS_DEFAULT=root,mariadb.sys,healthcheck,monitor,exporter,repl

# How long a peer probe may hang before it is treated as unreachable.
# REPL_PEER_CONNECT_TIMEOUT_DEFAULT=10

# replication/rebuild asks the primary's AQSH for a fresh physical backup before
# re-seeding. Set this once per deployment so callers never pass an address;
# they still supply their own bearer token per call.
# REPL_PEER_AQSH_URL_DEFAULT=http://aqsh-mariadb.<primary-site>:30080
# REPL_PEER_TASK_TIMEOUT_DEFAULT=900
