# Deploy-time configuration for MariaDB tasks.
# Mounted into aqsh at /etc/aqsh/config/mariadb.env via ConfigMap.
# Scripts source this file for environment-specific settings.

MINIO_ENDPOINT=http://minio.minio.svc.cluster.local:9000

# Deployment-convention defaults for migration/preflight's MinIO checks. Unlike
# MINIO_ENDPOINT above (the platform's own internal MinIO, used directly by
# backup/restore), migration/preflight's minio_endpoint/access_key/secret_key/
# bucket are caller-suppliable task inputs (the migration source may point at
# some OTHER MinIO entirely) — these *_DEFAULT settings are only the fallback
# used when a caller omits them, per the "Configuration Layers" resolution
# order in CLAUDE.md. Uncomment and point at this deployment's usual migration
# MinIO target if callers should get a sensible default instead of a WARN.
# MINIO_ENDPOINT_DEFAULT=http://minio.minio.svc.cluster.local:9000
# MINIO_ACCESS_KEY_DEFAULT=
# MINIO_SECRET_KEY_DEFAULT=
# MINIO_BUCKET_DEFAULT=

# CRD apiGroup of the mariadb-operator generation on this cluster. Normally
# auto-detected through Kubernetes API discovery (the group serving the
# `mariadbs` resource), so this stays commented. Set it explicitly only for an
# unusual fork whose group cannot be confidently detected. Default when
# unset/undetectable: k8s.mariadb.com.
# MARIADB_OPERATOR_GROUP_DEFAULT=k8s.mariadb.com

# Vault AppRole credentials for migration/write-db-env-to-vault — it writes pod
# environment variables (root password, etc.) to Vault instead of returning
# them in the task result. No hardcoded fallback exists for these: unlike
# *_DEFAULT settings elsewhere in this file, leaving them unset makes the task
# fail clearly (VAULT_NOT_CONFIGURED) rather than silently do nothing useful.
# These are deploy-time only, never task inputs — a per-call override would
# let a caller write under a different Vault identity than this deployment's.
# VAULT_ADDR=https://vault.internal:8200
# VAULT_MOUNT=secret
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=

# Secrets gateway (docs/mariadb/secrets.md). Never task inputs — the PGP key
# and the protected list are deployment facts, not per-call decisions.
# SECRETS_PGP_KEY_PATH_DEFAULT=/etc/aqsh/pgp/private.asc
# Comma/space-separated Secret names secrets/plan|apply|delete refuse to
# touch. MariaDB has no live root-credential auto-detect (operator CR
# conventions vary), so list the root-password Secret and any infra secrets
# (S3 credentials) here explicitly.
# SECRETS_PROTECTED_NAMES_DEFAULT=mariadb,minio
# Root-credential auto-detect reads MongoDB env conventions and can never
# succeed on this gateway — set false to skip its two kubectl calls per
# plan/apply/delete.
# SECRETS_AUTODETECT_DEFAULT=false
# LOG_LEVEL_DEFAULT=INFO            # baseline task log verbosity (log_level input overrides per call)
